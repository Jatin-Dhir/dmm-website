---
// Loading screen and page wipe. Shown only while JavaScript runs (html.js) and never under
// prefers-reduced-motion. motion.ts counts the real asset load top-right while the wordmark
// rises letter by letter; at 100 the cover wipes away along the site's diagonal with a violet
// edge and the wordmark glides into its place in the hero. On link clicks the same cover closes
// over the page before the next one loads.
import Wordmark from './Wordmark.astro';
import { site } from '../data/site';
---

<div class="loader" data-loader aria-hidden="true">
  <div class="loader-violet"></div>
  <div class="loader-cover">
    <div class="loader-ui">
      <div class="loader-top">
        <span>{site.name}<span class="loader-place"> — {site.address.city}, {site.address.region}</span></span>
        <span class="loader-count"><span data-loader-count>0</span>%</span>
      </div>
    </div>
  </div>
  <div class="loader-mark" data-loader-mark><Wordmark /></div>
</div>
