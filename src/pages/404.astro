---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="contact" aria-labelledby="nf-title">
    <div class="wrap">
      <div class="contact-top">
        <p class="meta nf-code" data-fade>404 — Not found</p>
        <p class="foot-kicker" data-fade>This page moved,</p>
        <h1 class="foot-email" id="nf-title" style="display: block" data-fade>or never existed.</h1>
        <div class="form-actions" style="margin-top: 48px" data-fade>
          <a class="btn" href="/">Go to the homepage</a>
          <a class="btn btn-ghost" href="/work/">See the work</a>
        </div>
      </div>
    </div>
  </section>
</Base>
